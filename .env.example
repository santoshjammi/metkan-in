# MITT website - environment reference
#
# Copy to .env.local, fill in real values, NEVER commit it.
#   cp .env.example .env.local
#
# .env.local is git-ignored. Values here are safe dummies and are never read at
# runtime; only the real file (or the host's environment) is.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the client bundle at build time.
# Never put a secret behind that prefix.

# ---------------------------------------------------------------------------
# Canonical origin of the site. Used for metadataBase, canonical URLs, Open Graph
# tags and the sitemap. No trailing slash. Must be the public https origin, not
# localhost - `npm run preflight` blocks on a placeholder value here.
NEXT_PUBLIC_SITE_URL=https://mitt.example.in

# ---------------------------------------------------------------------------
# Lead store. Directory for one JSONL file per month of enquiries.
# Created 0700, files 0600. Relative paths resolve against the process cwd;
# on a VPS prefer an absolute path on a persistent volume, e.g.
#   MITT_LEAD_DIR=/var/lib/mitt/enquiries
# Never inside .next/ or a directory the build wipes.
MITT_LEAD_DIR=./var/enquiries

# ---------------------------------------------------------------------------
# Enquiry rate limiter. Single-instance, in-memory fixed window per client IP.
# Defaults: 5 enquiries per 10 minutes. Raise only with a shared limiter behind it.
MITT_RATE_LIMIT_MAX=5
MITT_RATE_LIMIT_WINDOW_MS=600000

# ---------------------------------------------------------------------------
# Staff notification, channel A: webhook.
# HTTPS endpoint that accepts a JSON POST of the stored enquiry. A chat-ops
# inbound webhook, a mail relay or an automation platform all work. 5s timeout,
# never fails the request. Leave blank to use SMTP instead or to disable.
# Plain http:// is accepted ONLY for localhost, so a local sink can be tested.
MITT_NOTIFY_WEBHOOK=

# ---------------------------------------------------------------------------
# Staff notification, channel B: SMTP.
# All of HOST + FROM + MITT_NOTIFY_TO are required for SMTP to count as
# configured. USER/PASS may be omitted only for an unauthenticated relay on a
# trusted network - which in practice means you should set them.
#
# 	port 587 + SECURE=false  -> STARTTLS upgrade (typical for hosted mail)
# 	port 465 + SECURE=true   -> implicit TLS
MITT_SMTP_HOST=smtp.example.invalid
MITT_SMTP_PORT=587
# 'true' for implicit TLS on 465, 'false' (or unset) for STARTTLS on 587.
MITT_SMTP_SECURE=false
MITT_SMTP_USER=enquiries@example.invalid
# Use an app password, not the mailbox password. Never commit the real value.
MITT_SMTP_PASS=replace-with-app-password
# Envelope sender. Must be a domain the mail host is allowed to send as.
MITT_SMTP_FROM="MITT Website <enquiries@example.invalid>"
# Who receives the alert. Comma separated for more than one inbox.
MITT_NOTIFY_TO=ops@example.invalid
